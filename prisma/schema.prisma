// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id                   String    @id
  title                String
  date                 String
  sortDate             DateTime
  details              String?
  tag                  String?
  ambito               String?
  escaloes             String?
  licenca              String?
  regiao               String?
  distrito             String?
  source               String
  link                 String?
  extraLinks           String?
  
  // Deep Scraping Details
  organizador          String?
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  prices               String?
  description          String?
  insurance            String?
  prizes               String?
  programa             String?
  logo                 String?
  image                String?
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  translations         EventTranslation[]

  @@index([sortDate])
  @@index([source])
  @@index([regiao])
  @@index([distrito])
  @@index([ambito])
  @@index([tag])
}

model EventTranslation {
  id          String   @id @default(cuid())
  eventId     String
  language    String   // "en", "es", "fr", etc.
  title       String
  details     String?
  description String?
  programa    String?
  
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([eventId, language])
  @@index([language])
  @@index([eventId])
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String   // "INFO" | "WARN" | "ERROR"
  source    String   // "SCRAPER" | "CALENDAR" | "API" | "AUTH" | "CRON" | "SYSTEM"
  message   String
  details   String?  // JSON string or error stack trace
  userId    String?  // Optional Clerk userId if action performed by user
  userEmail String?  // Optional user email
  createdAt DateTime @default(now())

  @@index([level])
  @@index([source])
  @@index([createdAt])
}

model AccountDeletionRequest {
  id          String   @id @default(cuid())
  userId      String   @unique
  userEmail   String
  userName    String?
  type        String   @default("DELETE_ACCOUNT") // "DELETE_ACCOUNT" | "DELETE_DATA"
  reason      String?
  status      String   @default("PENDING") // "PENDING" | "PROCESSED" | "CANCELLED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model AnalyticsSession {
  id              String           @id @default(cuid())
  visitorId       String           // Anonymous visitor hash stored in client localStorage
  userId          String?          // Clerk userId if user is logged in
  userEmail       String?          // User email if logged in
  isAdmin         Boolean          @default(false) // Flag to exclude master admin & admins
  country         String           @default("Desconhecido")
  city            String           @default("Desconhecido")
  region          String?          // e.g. district / state code
  device          String           @default("Desktop") // "Mobile" | "Desktop" | "Tablet"
  browser         String           @default("Outro")   // "Chrome" | "Safari" | "Firefox" | "Edge" | etc.
  os              String           @default("Outro")   // "iOS" | "Android" | "Windows" | "macOS" | "Linux"
  referrer        String?          // Source URL or domain (e.g. google.com, direct)
  initialPath     String           @default("/")
  durationSeconds Int              @default(0)
  pageViewsCount  Int              @default(1)
  eventsCount     Int              @default(0)
  lastActiveAt    DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  events          AnalyticsEvent[]

  @@index([createdAt])
  @@index([visitorId])
  @@index([isAdmin])
  @@index([country])
  @@index([city])
  @@index([device])
  @@index([lastActiveAt])
}

model AnalyticsEvent {
  id          String            @id @default(cuid())
  sessionId   String
  visitorId   String
  type        String            // "PAGE_VIEW" | "EVENT_CLICK" | "SEARCH" | "FAVORITE_ADD" | "AGENDA_ADD" | "ICS_EXPORT" | "FILTER_CHANGE"
  path        String            // e.g. "/nacionais"
  targetId    String?           // e.g. event ID
  targetTitle String?           // e.g. "Granfondo Aldeias do Xisto"
  metadata    String?           // JSON string with extra details (search query, filter value, etc.)
  isAdmin     Boolean           @default(false)
  createdAt   DateTime          @default(now())

  session     AnalyticsSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([sessionId])
  @@index([visitorId])
  @@index([type])
  @@index([targetId])
  @@index([isAdmin])
  @@index([path])
}


